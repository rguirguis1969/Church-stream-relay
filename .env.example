# Password for the settings page. install.sh fills this in for you.
ADMIN_PASSWORD=change-me

# Optional: a web address for the settings page, e.g. relay.yourchurch.org
# Point that name's DNS "A record" at this server first. When set, the page is
# served securely at https://DOMAIN and port 8080 is closed to the outside.
DOMAIN=

# Shown on the settings page as the OBS server address. Leave blank to use
# whatever address you typed into your browser.
PUBLIC_HOST=

# Advanced: change these only if something else on the server uses them.
RTMP_PORT=1935
ADMIN_PORT=8080
ADMIN_BIND=0.0.0.0
# Serve the settings page under a sub-path behind your own reverse proxy, e.g. /relay
URL_PREFIX=
# Set to 1 when the page is only reached over https (install.sh does this with DOMAIN).
COOKIE_SECURE=
# IP of your own reverse proxy (as seen from the container), so login limits use the real visitor IP.
TRUSTED_PROXY=
